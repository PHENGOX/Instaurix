function(run_case name expected text)
    if(RUNNER)
        set(command "${RUNNER}" "${REPORTS}" "gpu-cli-${name}" --expect-success "${APP}")
    else()
        set(command "${APP}")
    endif()
    execute_process(COMMAND ${command} "${PROGRAM}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 30)
    if(NOT result STREQUAL "${expected}" OR NOT "${output}${errors}" MATCHES "${text}")
        message(FATAL_ERROR "GPU profile CLI ${name} failed: ${result}\n${output}\n${errors}")
    endif()
    if(expected EQUAL 0 AND NOT output MATCHES "Normal exit.*code=0")
        message(FATAL_ERROR "CLI profile did not finish the original program: ${output}")
    endif()
endfunction()
run_case(maxwell 0 "GPU profile: maxwell-reference" 500000 --hle-reference --homebrew-entry --gpu-profile maxwell-reference)
run_case(ampere 0 "declared classes only; GPU execution unavailable" 500000 --hle-reference --homebrew-entry --gpu-profile ampere-research)
run_case(unknown 1 "Unknown GPU profile" --gpu-profile switch2)
run_case(missing 1 "requires exactly one profile" --gpu-profile)
run_case(duplicate 1 "requires exactly one profile" --gpu-profile maxwell-reference --gpu-profile ampere-research)
run_case(scope 1 "requires --hle-reference --homebrew-entry" --gpu-profile maxwell-reference)
