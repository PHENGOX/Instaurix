string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(REPORTS "${REPORTS}/${run_id}")
foreach(mode IN ITEMS success fail crash missing)
    set(program "${PROBE}")
    if(mode STREQUAL success)
        set(args "space argument" "quote\"argument" "trailing\\")
    elseif(mode STREQUAL missing)
        set(program "${REPORTS}/missing.exe")
        set(args "unused")
    else()
        set(args "${mode}")
    endif()
    execute_process(COMMAND "${RUNNER}" "${REPORTS}" "${mode}" --expect-success "${program}" ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 15)
    file(GLOB paths "${REPORTS}/${mode}-*/report.json")
    list(LENGTH paths count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Missing unique ${mode} diagnostic report: ${output} ${errors}")
    endif()
    list(GET paths 0 path)
    file(READ "${path}" report)
    string(JSON stage GET "${report}" stage)
    string(JSON code GET "${report}" exit_code)
    if(mode STREQUAL success)
        if(NOT result STREQUAL "0" OR NOT stage STREQUAL completed OR NOT output MATCHES "argument round-trip passed")
            message(FATAL_ERROR "Success/argument propagation failed: ${report} ${errors}")
        endif()
    elseif(mode STREQUAL fail)
        if(NOT result STREQUAL "7" OR NOT code EQUAL 7 OR NOT stage STREQUAL nonzero_exit)
            message(FATAL_ERROR "Nonzero exit was not preserved: ${report}")
        endif()
    elseif(mode STREQUAL crash)
        if(result STREQUAL "0" OR NOT stage STREQUAL native_failure OR NOT code EQUAL 3762438722 OR NOT errors MATCHES "HOST_DIAGNOSTIC_FAILURE")
            message(FATAL_ERROR "Native failure was not recorded: ${report} ${errors}")
        endif()
    elseif(NOT stage STREQUAL launch_failed OR result STREQUAL "0")
        message(FATAL_ERROR "Launch failure was not recorded: ${report}")
    endif()
    if(NOT mode STREQUAL missing)
        get_filename_component(folder "${path}" DIRECTORY)
        file(READ "${folder}/output.log" captured)
        if(NOT captured MATCHES "Diagnostic probe started")
            message(FATAL_ERROR "Child output was not preserved")
        endif()
        string(JSON ram GET "${report}" initial_available_ram_bytes)
        string(JSON peak GET "${report}" peak_working_set_bytes)
        if(ram LESS_EQUAL 0 OR peak LESS_EQUAL 0)
            message(FATAL_ERROR "Memory measurements missing: ${report}")
        endif()
    endif()
endforeach()
file(MAKE_DIRECTORY "${REPORTS}/nested-ctest")
file(WRITE "${REPORTS}/nested-ctest/CTestTestfile.cmake"
    "add_test(native_failure \"${RUNNER}\" \"${REPORTS}\" \"expected-crash\" --expect-failure \"${PROBE}\" crash)\nset_tests_properties(native_failure PROPERTIES FAIL_REGULAR_EXPRESSION \"HOST_DIAGNOSTIC_FAILURE:\")\n")
execute_process(COMMAND "${CTEST}" --test-dir "${REPORTS}/nested-ctest" --output-on-failure
    RESULT_VARIABLE nested_result OUTPUT_VARIABLE nested_output ERROR_VARIABLE nested_errors TIMEOUT 15)
if(nested_result STREQUAL "0" OR NOT nested_output MATCHES "0% tests passed")
    message(FATAL_ERROR "An expected nonzero exit must not hide a native crash: ${nested_output} ${nested_errors}")
endif()
execute_process(COMMAND "${RUNNER}" "${REPORTS}" expected-failure --expect-failure "${PROBE}" fail
    RESULT_VARIABLE expected_failure TIMEOUT 15)
execute_process(COMMAND "${RUNNER}" "${REPORTS}" unexpected-success --expect-failure "${PROBE}"
    "space argument" "quote\"argument" "trailing\\" RESULT_VARIABLE unexpected_success TIMEOUT 15)
if(NOT expected_failure STREQUAL "0" OR unexpected_success STREQUAL "0")
    message(FATAL_ERROR "Expected-failure handling changed the negative-test contract")
endif()
message(STATUS "Host diagnostic success, nonzero exit, native exception and launch failure verified")
